<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>HarukiAssetStudioFFI</AssemblyName>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <NativeLib>Shared</NativeLib>
        <SelfContained>true</SelfContained>
        <!-- First-party code only uses InvariantCulture and the FFI contract is
             culture-independent (UTF-8 in/out, invariant formatting), so ICU can be
             dropped from the NativeAOT binary. -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- NativeAOT size trimming. Stack trace data is kept on purpose: exception
             text flows into per-item FFI error strings and the trace file sink. -->
        <StripSymbols>true</StripSymbols>
        <DebuggerSupport>false</DebuggerSupport>
        <EventSourceSupport>false</EventSourceSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Source-level NativeAOT warnings in the FFI path are fixed or documented with
             targeted suppressions. The remaining IL2026/IL2104/IL3053 output is
             third-party/BCL trim summary noise from legacy AssetStudio dependencies
             (Newtonsoft.Json, Mono.Cecil, Microsoft.CSharp, System.*), not the
             object-level FFI path. Keep publish output focused. -->
        <NoWarn>$(NoWarn);IL2026;IL2104;IL3053;NU1902</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Kyaru.Texture2DDecoder" Version="0.17.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.8" />
        <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AssetStudio\AssetStudio.csproj" SetTargetFramework="TargetFramework=net9.0" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;NativeLib;SelfContained" />
        <ProjectReference Include="..\AssetStudioCore\AssetStudioCore.csproj" SetTargetFramework="TargetFramework=net9.0" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;NativeLib;SelfContained" />
    </ItemGroup>

    <Target Name="CopyHarukiNativeAotRuntimeLibraries" AfterTargets="Publish">
        <ItemGroup>
            <HarukiRuntimeNativeLibrary Include="$(MSBuildThisFileDirectory)..\AssetStudioCore\Libraries\$(RuntimeIdentifier)\*.*" Condition="Exists('$(MSBuildThisFileDirectory)..\AssetStudioCore\Libraries\$(RuntimeIdentifier)')" />
        </ItemGroup>
        <Copy SourceFiles="@(HarukiRuntimeNativeLibrary)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition=" '@(HarukiRuntimeNativeLibrary)' != '' " />
    </Target>
</Project>
